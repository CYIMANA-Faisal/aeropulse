# Optional local CSV ingestion settings for Dagster.
# By default, Docker reads the CSVs from ./sources.

SOURCES_DIR=/opt/sources
AIRPORTS_SOURCE_FILE=/opt/sources/airports.csv
FLIGHTS_SOURCE_FILE=/opt/sources/flight_data_2024.csv
DELAY_CAUSES_SOURCE_FILE=/opt/sources/Airline_Delay_Cause.csv
SOURCE_BATCH_SIZE=50000

# Keep these as 0 to load every row. Set a small number for quick tests.
FLIGHTS_SOURCE_LIMIT=0
DELAY_CAUSES_SOURCE_LIMIT=0

# Optional API ingestion settings for Dagster.
# API data is used when the local source CSVs are not available.

AIRPORTS_API_URL=
AIRPORTS_API_DATA_PATH=
AIRPORTS_API_LIMIT=500

FLIGHTS_API_URL=
FLIGHTS_API_DATA_PATH=
FLIGHTS_API_LIMIT=500

# Shared API auth. You can also use AIRPORTS_API_KEY or FLIGHTS_API_KEY
# if the endpoints need different credentials.
API_KEY=
API_HEADER_NAME=Authorization
API_AUTH_SCHEME=Bearer

API_TIMEOUT_SECONDS=20
API_FALLBACK_TO_SAMPLE=true
